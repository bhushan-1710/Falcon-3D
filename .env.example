# ==========================================
# FALCON 3D PRINTS - ENVIRONMENT VARIABLES
# Add these variables in Vercel Project Settings > Environment Variables
# (Provide actual secret values in Vercel / .env.local; do not commit secrets)
# ==========================================

# 1. Turso Database (@libsql/client)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 2. Supabase Storage (files only, bucket: falcon-media)
# SUPABASE_URL is public/non-secret.
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is server-side SECRET only. Never expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=falcon-media

# 3. Application Configuration
SITE_URL=

# 4. Keep-Alive Cron Secret (for /api/cron/keepalive)
CRON_SECRET=
